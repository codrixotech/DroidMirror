# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Create a key once with:
#   keytool -genkeypair -v -keystore ~/droidmirror-release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias droidmirror
# Keep the keystore and passwords safe and backed up: Play needs the same
# upload key for every update.
storeFile=/Users/you/droidmirror-release.jks
storePassword=change-me
keyAlias=droidmirror
keyPassword=change-me
